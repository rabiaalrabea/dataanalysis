### Fit models with poLCA ###

### Method  ###
### Model ###
#Ref: https://www.youtube.com/watch?v=KH2UJbtFaYg
## Turn Numeric variables into factors ## 
newdata <- datalca
numericvarf <- c("age", "female", "com_arr", "com_cad", "com_cbvd", "com_diab", "com_hf", "com_hyp", "com_mal", "ihe_ctr", "lab_bmi", "lab_crp", "lab_egfr", "lab_gluc_nf", "lab_hb", "med_aht", "med_ata", "med_gla", "med_ims", "med_lla", "med_ntd", "aki_stage")

form <- as.formula(paste0("cbind(", paste(numericvarf, collapse = ","),") ~ 1"))

fit_gridf <- map_df(1:12, function(k){
+ set.seed(100 + k)
+ mod1 <- poLCA(form, data = newdata, nclass = k, nrep = 20, verbose = FALSE)
+ tibble(k =k, bic = mod1$bic, aic = mod1$aic, logLik = mod1$llik, npar = mod1$npar)
+ })

print(fit_gridf)

fit_grid_longf <- pivot_longer(
+ fit_grid1,
+ cols = c(bic),
+ names_to = "criterion",
+ values_to = "value"
+ )
> ggplot(fit_grid_longf, aes(x = k, y = value, color = criterion)) +
+ geom_line() +
+ geom_point() +
+ labs(
+ x = "Number of Classes",
+ y = "Fit Statistic",
+ title = "LCA Model Fit Comparison"
+ ) 
> theme_minimal()


